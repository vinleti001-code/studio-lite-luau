[configuration]
entry_symbol = "luau_ext_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]
android.debug.arm64 = "res://bin/lib/libluauext.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/lib/libluauext.android.template_release.arm64.so"
android.debug.x86_64 = "res://bin/lib/libluauext.android.template_debug.x86_64.so"
android.release.x86_64 = "res://bin/lib/libluauext.android.template_release.x86_64.so"
linux.debug.x86_64 = "res://bin/lib/libluauext.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/lib/libluauext.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/lib/libluauext.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/lib/libluauext.windows.template_release.x86_64.dll"
